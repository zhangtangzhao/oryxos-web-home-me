<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console: human-readable -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File: structured JSON into the workspace log dir (FR-027) -->
    <appender name="WORKSPACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ORYXOS_ROOT:-.oryxos}/logs/oryxos.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ORYXOS_ROOT:-.oryxos}/logs/oryxos.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{36}","thread":"%thread","msg":"%replace(%msg){'\&quot;', '\\\&quot;'}","ex":"%replace(%exception){'[\r\n]+', ' | '}"}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="WORKSPACE_FILE"/>
    </root>
    <logger name="com.oryxos" level="DEBUG"/>
</configuration>
